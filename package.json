  "magpie": {
    "name": "Mistral Vibe Code (unofficial)",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Mistral Vibe Code subscription (unofficial): browser sign-in or a Vibe Code API key; chat completions on api.mistral.ai billed to the plan's monthly Vibe Code budget, with plan and budget usage. Separate from the mistral API-key provider.",
